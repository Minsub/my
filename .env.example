# Neon pooled URL for the application. Keep all variables server-side.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional migration role (DDL). If absent scripts use DATABASE_URL.
MIGRATION_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=you@example.com
HOUSEHOLD_NAME=우리 집
# Local integration/E2E testing only. Never enabled on Vercel.
LOCAL_PASSWORD_AUTH=false
